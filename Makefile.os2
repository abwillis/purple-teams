#
# Makefile.os2 - OS/2 build for purple-teams
#

CC         = gcc
PKG_CONFIG = pkg-config
MAKE       = make

PKGS = purple glib-2.0 gobject-2.0 json-glib-1.0

CFLAGS = -O2 -Wall -Wno-unused-parameter -Wno-sign-compare
CFLAGS += -Ipurple2compat
CFLAGS += $(shell $(PKG_CONFIG) --cflags $(PKGS))

LDFLAGS = -Zdll -Zomf -Zmt

LIBS = $(shell $(PKG_CONFIG) --libs $(PKGS)) -lz

TARGET          = teams.dll
PERSONAL_TARGET = teamsp.dll

SOURCES = \
	teams_connection.c \
	teams_contacts.c \
	teams_login.c \
	teams_messages.c \
	teams_util.c \
	purple-websocket.c \
	teams_trouter.c \
	teams_cards.c \
	markdown.c \
	libteams.c \
	purple2compat/http.c \
	purple2compat/purple-socket.c

OBJECTS = $(SOURCES:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJECTS) teams.def
	$(CC) $(LDFLAGS) -o $@ $(OBJECTS) teams.def $(LIBS)

personal: between
	$(MAKE) CFLAGS="$(CFLAGS) -DENABLE_TEAMS_PERSONAL" -f Makefile.os2 $(PERSONAL_TARGET)

$(PERSONAL_TARGET): $(OBJECTS) teamsp.def
	$(CC) $(LDFLAGS) -o $@ $(OBJECTS) teamsp.def $(LIBS)

.c.o:
	$(CC) $(CFLAGS) -c $< -o $@

between:
	rm -f *.o
clean:
	rm -f $(OBJECTS) $(TARGET) $(PERSONAL_TARGET)

.PHONY: all personal clean
